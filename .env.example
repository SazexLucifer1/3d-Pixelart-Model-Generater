# Voxel Forge – optionale KI-Anbindungen
# Ohne Einträge läuft der prozedurale Generator (offline, fester Wortschatz).
# Für die .exe: diese Datei als ".env" (oder ".env.txt") neben VoxelForge.exe legen.
# Ein Schlüssel genügt – z.B. nur GEMINI_API_KEY.

# Claude (Anthropic) – LLM-Prompt-Interpretation
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Google Gemini – LLM-Prompt-Interpretation (Schlüssel: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash   (fehlt das Modell, wird automatisch ein verfügbares gewählt)

# Lokales LLM über Ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# Stable Diffusion (AUTOMATIC1111 / Forge, mit --api gestartet)
# SD_API_URL=http://localhost:7860

# Text-zu-3D-Dienst: POST {prompt, seed} → OBJ-Text
# TEXT_TO_3D_URL=http://localhost:9000/generate

# Server
# PORT=8787
# PROJECTS_DIR=data/projects
